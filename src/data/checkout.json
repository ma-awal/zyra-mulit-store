{
  "steps": ["Shipping", "Payment", "Confirmation"],
  "shippingFields": [
    {
      "name": "fullName",
      "label": "Full Name",
      "type": "text",
      "autoComplete": "name",
      "placeholder": "Sarah Ahmed",
      "span": 2
    },
    {
      "name": "email",
      "label": "Email",
      "type": "email",
      "autoComplete": "email",
      "placeholder": "sarah@example.com",
      "span": 2
    },
    {
      "name": "address",
      "label": "Address",
      "type": "text",
      "autoComplete": "street-address",
      "placeholder": "12 Rue des Fleurs",
      "span": 2
    },
    {
      "name": "city",
      "label": "City",
      "type": "text",
      "autoComplete": "address-level2",
      "placeholder": "Algiers",
      "span": 2
    },
    {
      "name": "phone",
      "label": "Phone Number",
      "type": "tel",
      "autoComplete": "tel",
      "placeholder": "+213 555 123 456",
      "span": 1
    },
    {
      "name": "postalCode",
      "label": "Postal Code",
      "type": "text",
      "autoComplete": "postal-code",
      "placeholder": "16000",
      "span": 1
    }
  ],
  "paymentMethods": [
    {
      "id": "card",
      "label": "Credit / Debit Card",
      "badges": ["VISA", "MC", "AMEX", "DISC"]
    },
    { "id": "paypal", "label": "PayPal", "badge": "PayPal" },
    { "id": "apple", "label": "Apple Pay", "badge": "Apple Pay" },
    { "id": "cod", "label": "Cash on Delivery", "icon": "package" }
  ],
  "placed": {
    "title": "Order Placed!",
    "text": "Thank you for your order.",
    "image": "/images/order-success.webp",
    "imageAlt": "A delivery box on a golden pedestal with a thank you note"
  }
}
